{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "api/**/*.ts",
    "server/brightData.ts",
    "server/config.ts",
    "server/normalize.ts",
    "src/domain/intelligence.ts",
    "src/lib/validateSnapshot.ts"
  ]
}
